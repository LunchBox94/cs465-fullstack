<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>Dive Sites - Bhaccasyoniztas Beach Resort Website Template</title>

	<!-- Load the website stylesheet -->
	<link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">

			<!-- Display the shared header -->
			{{> header}}

			<div id="contents">
				<div class="box">
					<div>
						<div class="body">

							<!-- Travel page heading -->
							<h1>Travel</h1>

							<!-- Show all trips from the JSON file -->
							<ul id="sites">

								{{#each trips}}

								<li>

									<!-- Display the trip image -->
									<a href="/travel">
										<img src="/images/{{this.image}}" alt="{{this.name}}">
									</a>

									<!-- Display the trip name -->
									<h2>
										<a href="/travel">{{this.name}}</a>
									</h2>

									<!-- Display the trip description -->
									<p>
										{{this.description}}
									</p>

								</li>

								{{/each}}

							</ul>

						</div>
					</div>
				</div>
			</div>

		</div>

		<!-- Display the shared footer -->
		{{> footer}}

	</div>
</body>
</html>